# Talon runtime
TALON_GATEWAY=http://127.0.0.1:8080
# MCP proxy runs as a second, non-gateway Talon process (agent-key auth); see docs/SETUP.md section 5.
TALON_MCP_GATEWAY=http://127.0.0.1:8081
TALON_CONFIG=
TALON_DATA_DIR=
TALON_SECRETS_KEY=
TALON_SIGNING_KEY=
TALON_ADMIN_KEY=

# Provider credentials for the live-provider cut; never commit values
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Talon traffic identities
TALON_CUSTOMER_SUPPORT_KEY=
TALON_CODING_ASSISTANT_KEY=
TALON_DOCUMENT_SUMMARY_KEY=

# Zendesk Talon route
TALON_CUSTOMER_SUPPORT_PROVIDER=local-llama
TALON_CUSTOMER_SUPPORT_MODEL=llama3.2:1b

# Stable demo sessions
TALON_COPILOT_SESSION_ID=copilot-billing-demo
TALON_N8N_SESSION_ID=n8n-quarterly-demo

# Zendesk adapter
ZENDESK_ADAPTER_TOKEN=
ZENDESK_ADAPTER_DOMAIN=
ZENDESK_ADAPTER_BIND=127.0.0.1:8443

# Copilot session shim
COPILOT_SHIM_BIND=127.0.0.1:8079

# Synthetic release MCP upstream
RELEASE_MCP_BIND=127.0.0.1:8090
RELEASE_MCP_RECEIPTS=

# n8n
N8N_ENCRYPTION_KEY=
