      "position": [-512, 120]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const filename = String($json.fileName || '');\nconst match = filename.match(/^(\\d+)-(.+)\\.md$/);\nif (!match) throw new Error(`Unexpected quarterly input filename: ${filename}`);\nreturn { json: { order: match[1], slug: match[2], filename, content: String($json.content || '') } };"
      },
