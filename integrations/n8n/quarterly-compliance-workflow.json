    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const section = $('Loop Over Sections').item.json;\nconst text = $json.body?.content?.[0]?.text;\nif (typeof text !== 'string' || !text.trim()) throw new Error('Talon returned no Anthropic summary text');\nconst fileName = `${section.order}-${section.slug}.summary.md`;\nconst markdown = `## ${section.filename}\\n\\n${text.trim()}\\n`;\nreturn {\n  json: { ...section, statusCode: $json.statusCode, outputFile: fileName },\n  binary: { data: { data: Buffer.from(markdown, 'utf8').toString('base64'), mimeType: 'text/markdown', fileName, fileExtension: 'md' } }\n};"
      },
