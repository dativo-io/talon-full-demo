    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const section = $('Loop Over Sections').item.json;\nconst status = {\n  status: 'partial',\n  reason: 'session_budget_exceeded',\n  session_id: $env.TALON_N8N_SESSION_ID,\n  stopped_before: section.filename,\n  provider_cost_usd: 0,\n  message: String($json.body?.error?.message || 'Next request denied by Talon session budget')\n};\nconst rendered = JSON.stringify(status, null, 2) + '\\n';\nreturn {\n  json: status,\n  binary: { data: { data: Buffer.from(rendered, 'utf8').toString('base64'), mimeType: 'application/json', fileName: 'status.json', fileExtension: 'json' } }\n};"
      },
